# Servidor Local
PORT=3123
# Por padrão o servidor só aceita conexões deste computador (127.0.0.1).
# Use 0.0.0.0 apenas se quiser abrir o editor a partir de outro aparelho da rede.
# HOST=127.0.0.1

# Chaves de API de IA e Mídia (Opcional: também podem ser configuradas pela interface do Editor)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=

# Executável customizado do navegador Chrome para renderização Remotion (Opcional)
# REMOTION_BROWSER_EXECUTABLE=
